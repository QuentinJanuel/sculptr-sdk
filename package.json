{
  "name": "@sculptr/sdk",
  "version": "2.17.1",
  "description": "Write sculptr mods for GameMaker 8 and GameMaker Studio games.",
  "keywords": [
    "gamemaker",
    "gml",
    "mod",
    "sculptr"
  ],
  "homepage": "https://github.com/QuentinJanuel/sculptr-sdk#readme",
  "bugs": "https://github.com/QuentinJanuel/sculptr-sdk/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinJanuel/sculptr-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check && oxlint && tsc --noEmit",
    "fix": "oxfmt && oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
